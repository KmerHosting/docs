{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "KmerHosting",
  "description": "Official documentation for KmerHosting products and developer tools.",
  "colors": { "primary": "#1A73E8", "light": "#8AB4F8", "dark": "#1A73E8" },
  "appearance": { "default": "light", "strict": false },
  "favicon": "/images/favicon-192.png",
  "icons": { "library": "lucide" },
  "styling": { "eyebrows": "breadcrumbs" },
  "contextual": { "options": ["copy", "view"], "display": "header" },
  "logo": { "light": "/images/logo-docs-light.png", "dark": "/images/logo-docs-dark.png", "href": "https://kmerhosting.com" },
  "navbar": { "links": [{ "label": "Customer Dashboard", "href": "https://dashboard.kmerhosting.com" }] },
  "footer": { "socials": { "github": "https://github.com/KmerHosting" } },
  "navigation": {
    "global": { "anchors": [
      { "anchor": "Home", "icon": "house", "href": "/" },
      { "anchor": "Blog", "icon": "notebook", "href": "https://blog.kmerhosting.com" },
      { "anchor": "System status", "icon": "activity", "href": "https://status.kmerhosting.com" }
    ] },
    "groups": [
      { "group": "Start here", "icon": "rocket", "pages": ["quickstart", "console/overview", "console/account-and-billing", "console/api-activity"] },
      { "group": "Products", "icon": "boxes", "pages": ["products/overview", "products/domains", "products/email-hosting", "products/shared-hosting", "products/lxc-vps", "products/kvm-vps", "products/wfilemanager"] },
      { "group": "Platform", "icon": "network", "pages": ["platform/architecture", "platform/security", "platform/regions-and-networking", "platform/roadmap"] },
      { "group": "Developer platform", "icon": "braces", "pages": ["developer/overview", "developer/api-keys", "developer/rest-api", "developer/sdk", "developer/cli", "developer/mcp", "api/errors"] },
      { "group": "API reference", "icon": "terminal", "openapi": { "source": "openapi.json", "directory": "api-reference" } },
      { "group": "Help", "icon": "life-buoy", "pages": ["troubleshooting/overview", "troubleshooting/access-and-credentials", "troubleshooting/operations", "troubleshooting/dns-and-email", "troubleshooting/billing-and-renewals"] }
    ]
  },
  "redirects": [
    { "source": "/products/tiny-vps", "destination": "/products/lxc-vps", "permanent": true },
    { "source": "/products/vps", "destination": "/products/overview", "permanent": true },
    { "source": "/solutions/domains", "destination": "/products/domains", "permanent": true },
    { "source": "/solutions/professional-email", "destination": "/products/email-hosting", "permanent": true },
    { "source": "/solutions/shared-hosting", "destination": "/products/shared-hosting", "permanent": true },
    { "source": "/solutions/tiny-vps", "destination": "/products/lxc-vps", "permanent": true },
    { "source": "/solutions/vps", "destination": "/products/lxc-vps", "permanent": true },
    { "source": "/solutions/custom-hosting", "destination": "/products/overview", "permanent": true },
    { "source": "/developer/ai-agent", "destination": "/developer/overview", "permanent": true },
    { "source": "/products/kmerhosting-cli", "destination": "/developer/cli", "permanent": true },
    { "source": "/products/kmerhosting-forge", "destination": "/developer/overview", "permanent": true },
    { "source": "/products/kmerhosting-ai-agent", "destination": "/developer/overview", "permanent": true },
    { "source": "/products/kmerhosting-drive", "destination": "/products/overview", "permanent": true },
    { "source": "/products/webcpl", "destination": "/products/overview", "permanent": true },
    { "source": "/products/wfilemanager", "destination": "/products/overview", "permanent": true },
    { "source": "/guides/dns-management", "destination": "/products/domains", "permanent": true },
    { "source": "/guides/tiny-vps", "destination": "/products/lxc-vps", "permanent": true },
    { "source": "/guides/shared-hosting-stacks", "destination": "/products/shared-hosting", "permanent": true },
    { "source": "/api/overview", "destination": "/developer/rest-api", "permanent": true },
    { "source": "/api/authentication", "destination": "/developer/api-keys", "permanent": true }
  ]
}
