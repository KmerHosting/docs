{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "KmerHosting",
  "description": "Official documentation for KmerHosting products and developer tools.",
  "seo": {
    "metatags": {
      "canonical": "https://kmerhosting.com/docs"
    }
  },
  "colors": {
    "primary": "#1A73E8",
    "light": "#8AB4F8",
    "dark": "#1A73E8"
  },
  "appearance": {
    "default": "light",
    "strict": false
  },
  "favicon": "/images/favicon-192.png",
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "contextual": {
    "options": [
      "copy",
      "view"
    ],
    "display": "header"
  },
  "logo": {
    "light": "/images/logo-docs-light.png",
    "dark": "/images/logo-docs-dark.png",
    "href": "https://kmerhosting.com"
  },
  "navbar": {
    "links": [
      {
        "label": "Blog",
        "href": "https://blog.kmerhosting.com"
      },
      {
        "label": "Support",
        "href": "https://kmerhosting.com/support"
      },
      {
        "label": "Dashboard",
        "href": "https://dashboard.kmerhosting.com"
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/KmerHosting"
    }
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Website",
          "icon": "globe",
          "href": "https://kmerhosting.com"
        }
      ]
    },
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get started",
            "icon": "rocket",
            "pages": [
              "index",
              "quickstart"
            ]
          },
          {
            "group": "Customer Dashboard",
            "icon": "layout-dashboard",
            "pages": [
              "console/overview",
              "console/account-and-billing",
              "console/api-activity"
            ]
          },
          {
            "group": "Platform",
            "icon": "network",
            "pages": [
              "platform/architecture",
              "platform/security",
              "platform/regions-and-networking",
              "platform/roadmap"
            ]
          },
          {
            "group": "Help",
            "icon": "life-buoy",
            "pages": [
              "troubleshooting/overview",
              "troubleshooting/access-and-credentials",
              "troubleshooting/operations",
              "troubleshooting/dns-and-email",
              "troubleshooting/billing-and-renewals"
            ]
          }
        ]
      },
      {
        "tab": "Services",
        "groups": [
          {
            "group": "Web hosting",
            "icon": "panels-top-left",
            "pages": [
              "products/shared-hosting",
              "products/free-hosting"
            ]
          },
          {
            "group": "VPS",
            "icon": "server",
            "pages": [
              "products/lxc-vps",
              "products/kvm-vps"
            ]
          },
          {
            "group": "Domains",
            "icon": "globe",
            "pages": [
              "products/domains"
            ]
          },
          {
            "group": "Professional email",
            "icon": "mail",
            "pages": [
              "products/email-hosting"
            ]
          }
        ]
      },
      {
        "tab": "Products",
        "groups": [
          {
            "group": "KmerHosting products",
            "icon": "boxes",
            "pages": [
              "products/overview",
              "products/wfilemanager",
              "products/convertsuite"
            ]
          }
        ]
      },
      {
        "tab": "SDKs & Tools",
        "groups": [
          {
            "group": "Developer platform",
            "icon": "braces",
            "pages": [
              "developer/overview",
              "developer/api-keys",
              "developer/rest-api",
              "developer/sdk",
              "developer/cli",
              "developer/mcp",
              "api/errors"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "API Reference",
            "icon": "terminal",
            "openapi": {
              "source": "openapi.json",
              "directory": "api-reference"
            }
          }
        ]
      }
    ]
  },
  "redirects": [
